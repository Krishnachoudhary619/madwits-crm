APP_NAME=Madweb CRM
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (used by Docker Compose and by the API to build DATABASE_URL)
POSTGRES_USER=madweb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=madweb_crm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional override. If unset, the API builds the URL from POSTGRES_* values.
# Inside Docker Compose the API service always uses host "postgres".
# DATABASE_URL=postgresql+psycopg://madweb:change-me@localhost:5432/madweb_crm
