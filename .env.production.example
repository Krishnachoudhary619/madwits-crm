# Copy to .env on the production host. Never commit the real file.
#   cp .env.production.example .env

APP_NAME=Madweb CRM
APP_ENV=production
WEB_PORT=3000

# Set to false only if the shop opens the CRM over plain HTTP (no HTTPS).
# Login cookies will not be stored by browsers if this is true on HTTP.
COOKIE_SECURE=true

POSTGRES_USER=madweb
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=madweb_crm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# At least 32 characters. Do not reuse the development placeholder.
JWT_SECRET=replace-with-a-long-random-jwt-secret-value
JWT_EXPIRE_MINUTES=720

SHOP_TIMEZONE=Asia/Kolkata
